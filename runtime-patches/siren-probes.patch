+/* PS3_THDUMP=<secs>: host-side sampler logging every live guest thread's
+ * (tid, cia, name) every <secs> seconds. Diagnoses multi-thread stalls
+ * (which thread is parked where) without stopping the run. */
+#ifdef _WIN32
+static DWORD WINAPI thdump_thread(LPVOID p)
+{
+    (void)p;
+    const char* e = getenv("PS3_THDUMP");
+    int secs = e ? atoi(e) : 0;
+    if (secs <= 0) return 0;
+    for (;;) {
+        Sleep((DWORD)secs * 1000u);
+        for (int i = 0; i < PPU_THREAD_MAX; i++) {
+            ppu_thread_info* t = &g_ppu_threads[i];
+            if (t->state == PPU_THREAD_STATE_FREE) continue;
+            unsigned live = (unsigned)t->ctx.cia;
+            fprintf(stderr, "[THDUMP] tid=%u live=0x%08X prof=0x%08X st=%d %s\n",
+                    (unsigned)(i + 1), live, t->prof_pc, (int)t->state,
+                    t->name ? t->name : "?");
+        }
+        { unsigned tid = 0, cia = 0; const char* name = "?";
+          if (ppu_prof_snapshot(0, &tid, &cia, &name))
+              fprintf(stderr, "[THDUMP] tid=%u live=-------- prof=0x%08X (main) %s\n", tid, cia, name ? name : "?"); }
+        fprintf(stderr, "[THDUMP] --- end\n"); fflush(stderr);
+    }
+    return 0;
+}
+__attribute__((constructor)) static void thdump_start(void)
+{
+    const char* e = getenv("PS3_THDUMP");
+    if (e && atoi(e) > 0) {
+        DWORD id = 0; HANDLE h = CreateThread(NULL, 0, thdump_thread, NULL, 0, &id);
+        if (h) CloseHandle(h);
+    }
